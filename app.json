{
  "expo": {
    "name": "FindMyPanini",
    "slug": "findmypanini",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "findmypanini",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A0A0A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.matteotheo.findmypanini",
      "infoPlist": {
        "NSCameraUsageDescription": "FindMyPanini a besoin de la caméra pour scanner vos stickers Panini.",
        "NSPhotoLibraryUsageDescription": "FindMyPanini peut accéder à votre galerie pour scanner une photo de sticker."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E31E24"
      },
      "package": "com.matteotheo.findmypanini",
      "permissions": ["android.permission.CAMERA", "android.permission.READ_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-camera", { "cameraPermission": "FindMyPanini a besoin de la caméra pour scanner vos stickers." }],
      ["expo-av", { "microphonePermission": false }]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
